  "cors": {"origin": "https://pwnscout-evil.example"},
  "crlf": {"payload": "%0d%0aPwnscout-Injected:1", "header": "pwnscout-injected"},
  "security_headers": {
    "content-security-policy": "no Content-Security-Policy — clickjacking/XSS mitigation missing",
    "strict-transport-security": "no HSTS — TLS downgrade / SSL-strip risk",
    "x-content-type-options": "no X-Content-Type-Options: nosniff — MIME sniffing",
